# Live product data + product photos come from Netlify Functions that talk
# to the Etsy API server-side (see netlify/functions/products.js, img.js).
# Friendly /api/... paths instead of the raw /.netlify/functions/... ones.
/api/products                 /.netlify/functions/products  200
/api/img                      /.netlify/functions/img       200

# The hero banner photo is still a single fixed image (not part of the live
# product grid) -- proxied the same way so the browser never talks to
# i.pinimg.com directly (common ad-blocker / tracker-protection target).
/img/hero.jpg                 https://i.pinimg.com/736x/3c/ed/fc/3cedfc91311cc8e52ed4f273fd8bbacb.jpg  200
